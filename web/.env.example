# Neon PostgreSQL (use pooled connection string from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Generate: openssl rand -hex 32
PAYLOAD_SECRET=your-32-char-minimum-secret-here

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: protect /dashboard in production (?key=... or cookie)
DASHBOARD_ACCESS_KEY=your-dashboard-preview-key
