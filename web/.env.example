# Neon PostgreSQL (use pooled connection string from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Generate: openssl rand -hex 32
PAYLOAD_SECRET=your-32-char-minimum-secret-here

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Tag Manager container (GTM only loads when set)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Secrets live only in Vercel project env (server-side). Never commit real
# --- values; the dashboard only ever reports presence, never the value.
# /dashboard is protected by the Payload user session (Users collection) —
# create users in /admin, there is no shared dashboard key.
